{
  "name": "agentos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentOS — framework for building extensible products (Shell, extensions, Bun APIs, Python services)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/tejasStarboard/agentos#readme",
  "bugs": {
    "url": "https://github.com/tejasStarboard/agentos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejasStarboard/agentos.git"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@agentos/client-app",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "bun test",
    "ci": "turbo run //#lint //#format:check typecheck build //#test",
    "postinstall": "bun ./scripts/uv-sync.ts",
    "python:sync": "bun ./scripts/uv-sync.ts",
    "deploy:cloudflare": "pnpm --filter @agentos/deploy-cloudflare run deploy",
    "deploy:cloudflare:dev": "pnpm --filter @agentos/deploy-cloudflare run deploy:dev",
    "clean": "turbo run clean && bun ./scripts/clean.ts"
  },
  "devDependencies": {
    "@agentos/typescript-config": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  }
}
