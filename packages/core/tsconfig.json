{
  "extends": "@agentos/typescript-config/base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@agentos/core": ["./src/index.ts"],
      "@agentos/core/api/*": ["./src/api/lib/*"],
      "@agentos/core/builtins/*/env": ["./builtins/*/api/env.ts"],
      "@agentos/core/builtins/*": ["./builtins/*"],
      "@agentos/core/client/lib/*": ["./src/client/lib/*"],
      "@agentos/core/client/components/*": ["./src/client/components/*"],
      "@agentos/core/gateway/lib/*": ["./src/gateway/lib/*"],
      "@agentos/core/vite/lib/*": ["./src/vite/lib/*"],
      "@agentos/core/agent/lib/*": ["./src/agent/lib/*"],
      "@agentos/core/shell/mount": ["./src/shell/mount.tsx"],
      "@agentos/core/shell/*": ["./src/shell/*/index.ts"],
      "@agentos/core/*": ["./src/*/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "builtins/**/*.ts",
    "builtins/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules"]
}
