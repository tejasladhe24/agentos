{
  "name": "@agentos/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AgentOS framework — Shell, Comlink SDK, Bun API kit, Vite gateway, and builtins",
  "license": "UNLICENSED",
  "homepage": "https://github.com/tejasStarboard/agentos/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/tejasStarboard/agentos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejasStarboard/agentos.git",
    "directory": "packages/core"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "agentos": "./bin/agentos"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./client/lib/*": [
      "./src/client/lib/*.ts",
      "./src/client/lib/*.tsx"
    ],
    "./client/components/*": "./src/client/components/*.tsx",
    "./api": "./src/api/index.ts",
    "./api/*": "./src/api/lib/*.ts",
    "./builtins/*/env": "./builtins/*/api/env.ts",
    "./builtins/*": [
      "./builtins/*.ts",
      "./builtins/*.tsx"
    ],
    "./config": "./src/config/index.ts",
    "./gateway": "./src/gateway/index.ts",
    "./gateway/lib/*": [
      "./src/gateway/lib/*.ts",
      "./src/gateway/lib/*.tsx"
    ],
    "./vite": "./src/vite/index.ts",
    "./vite/lib/*": [
      "./src/vite/lib/*.ts",
      "./src/vite/lib/*.tsx"
    ],
    "./sdk": "./src/sdk/index.ts",
    "./agent": "./src/agent/index.ts",
    "./agent/lib/*": [
      "./src/agent/lib/*.ts",
      "./src/agent/lib/*.tsx"
    ],
    "./shell": "./src/shell/index.ts",
    "./shell/mount": "./src/shell/mount.tsx",
    "./shell/*": "./src/shell/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun ./scripts/dev-bffs.ts",
    "auth:dev": "bun ./builtins/auth/api/server.ts",
    "db-store:dev": "bun ./builtins/db-store/api/server.ts",
    "cache-store:dev": "bun ./builtins/cache-store/api/server.ts",
    "ai:dev": "bun ./builtins/ai/api/server.ts",
    "hitl:dev": "bun ./builtins/hitl/api/server.ts",
    "events:dev": "bun ./builtins/events/api/server.ts",
    "files:dev": "bun ./builtins/files/api/server.ts",
    "notifications:dev": "bun ./builtins/notifications/api/server.ts",
    "secrets:dev": "bun ./builtins/secrets/api/server.ts",
    "audit:dev": "bun ./builtins/audit/api/server.ts",
    "vector-store:dev": "bun ./builtins/vector-store/api/server.ts",
    "inbound-email:dev": "bun ./builtins/inbound-email/api/server.ts",
    "clean": "rm -rf dist node_modules .turbo .venv __pycache__ .pytest_cache *.egg-info .ruff_cache .mypy_cache *.tsbuildinfo"
  },
  "dependencies": {
    "@agentos/ui": "workspace:*",
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.125",
    "@ai-sdk/openai": "^4.0.122",
    "@better-auth/sso": "^1.7.27",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "ai": "^7.0.181",
    "better-auth": "^1.7.27",
    "comlink": "^4.4.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "postal-mime": "^4.2.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "peerDependencies": {
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@agentos/typescript-config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^6.3.5"
  }
}
