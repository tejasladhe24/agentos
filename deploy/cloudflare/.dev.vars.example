# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars).
# Mirror production secrets you would set with `wrangler secret put`.

AGENT_OS_EXT_AUTH_SECRET=replace-with-at-least-32-chars-secret!!
AGENT_OS_EXT_AUTH_DB=postgres://user:pass@host/db
AGENT_OS_EXT_DB_STORE_DATABASE_URL=postgres://user:pass@host/db
AGENT_OS_GLOBAL_APP_ORIGIN=http://127.0.0.1:8787
AGENT_OS_EXT_AUTH_BASE_URL=http://127.0.0.1:8787
AGENT_OS_EXT_FILES_S3_BUCKET=agentos-files
AGENT_OS_EXT_FILES_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
AGENT_OS_EXT_FILES_S3_REGION=auto
AGENT_OS_EXT_FILES_S3_ACCESS_KEY_ID=
AGENT_OS_EXT_FILES_S3_SECRET_ACCESS_KEY=
