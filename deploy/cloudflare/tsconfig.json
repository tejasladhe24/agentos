{
  "extends": "@agentos/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true,
    "rootDir": ".",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["worker.ts", "lib/**/*.ts", "env.d.ts"],
  "exclude": ["lib/**/*.test.ts"]
}
